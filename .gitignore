# Ambiente e segredos
.env
*.local

# Dados sensíveis: uploads e exportações nunca vão para o versionamento
uploads/
exports/
tmp/

# Fixtures binários de demonstração: gerados por `make demo-data`. Os
# containers ZIP (.xlsx/.docx) e o PDF gravam data de modificação e um /ID
# novos a cada execução, então versioná-los criaria um diff a cada geração.
# As versões em texto (.csv e .txt) continuam versionadas.
samples/input/*.xlsx
samples/input/*.docx
samples/input/*.pdf

# IDE / SO
.idea/
.vscode/
.DS_Store
Thumbs.db

# Configuração local do Claude Code (não versionar)
.claude/settings.local.json
